{
  "apf-preset": 1,
  "plugin": "com.nodaw.harmonic-space",
  "name": "Slapback Rap",
  "type": "Space",
  "subtype": "Space",
  "mood": [
    "Tight",
    "Edgy"
  ],
  "description": "One quick ~0.2 s slap, almost no reverb, a bit of 2-4 kHz edge.",
  "author": "NoDAW",
  "params": {
    "hpf": 106.4,
    "lpf": 20000,
    "dly_mix": 14,
    "dly_time": 226,
    "rev_mix": 1.3,
    "b1_gain": -0.48,
    "b2_gain": -0.48,
    "b3_gain": -0.48,
    "b4_gain": 0.96,
    "b5_gain": 0.96,
    "b6_gain": 0.48,
    "b7_gain": 0.48
  }
}
