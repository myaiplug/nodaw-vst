{
  "apf-preset": 1,
  "plugin": "com.nodaw.screw",
  "name": "Tape Warble",
  "type": "Tape",
  "subtype": "Warble",
  "mood": [
    "Warm",
    "Nostalgic"
  ],
  "description": "Wow and flutter with no pitch change",
  "author": "NoDAW",
  "params": {
    "in_gain": 0,
    "out_gain": 0,
    "mix": 100,
    "pitch": 0,
    "wow": 28,
    "wow_rate": 0.9,
    "flutter": 35,
    "lowpass": 12500,
    "bass": 1.5,
    "rev_mix": 10,
    "rev_decay": 1.2,
    "rev_size": 1,
    "rev_damp": 6000,
    "rev_pre": 20,
    "chop_pattern": "Off",
    "chop_rate": "1/8",
    "chop_depth": 100,
    "width": 100,
    "limiter": true,
    "ceiling": -1
  }
}
