{
  "apf-preset": 1,
  "plugin": "com.nodaw.screw",
  "name": "Wide Dream",
  "type": "Space",
  "subtype": "Wide",
  "mood": [
    "Dreamy",
    "Wide"
  ],
  "description": "Almost no pitch change, a big soft space",
  "author": "NoDAW",
  "params": {
    "in_gain": 0,
    "out_gain": 0,
    "mix": 80,
    "pitch": -0.5,
    "wow": 0,
    "wow_rate": 0.7,
    "flutter": 0,
    "lowpass": 20000,
    "bass": 0,
    "rev_mix": 55,
    "rev_decay": 8,
    "rev_size": 1.5,
    "rev_damp": 5200,
    "rev_pre": 45,
    "chop_pattern": "Off",
    "chop_rate": "1/8",
    "chop_depth": 100,
    "width": 170,
    "limiter": true,
    "ceiling": -1
  }
}
