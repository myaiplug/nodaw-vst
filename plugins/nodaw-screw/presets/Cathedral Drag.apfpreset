{
  "apf-preset": 1,
  "plugin": "com.nodaw.screw",
  "name": "Cathedral Drag",
  "type": "Space",
  "subtype": "Huge",
  "mood": [
    "Huge",
    "Ambient"
  ],
  "description": "Long, dark tails behind a deep drop",
  "author": "NoDAW",
  "params": {
    "in_gain": 0,
    "out_gain": 0,
    "mix": 90,
    "pitch": -5,
    "wow": 0,
    "wow_rate": 0.7,
    "flutter": 0,
    "lowpass": 9000,
    "bass": 0,
    "rev_mix": 60,
    "rev_decay": 14,
    "rev_size": 1.8,
    "rev_damp": 3200,
    "rev_pre": 60,
    "chop_pattern": "Off",
    "chop_rate": "1/8",
    "chop_depth": 100,
    "width": 150,
    "limiter": true,
    "ceiling": -1
  }
}
