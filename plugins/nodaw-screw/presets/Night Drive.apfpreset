{
  "apf-preset": 1,
  "plugin": "com.nodaw.screw",
  "name": "Night Drive",
  "type": "Screw",
  "subtype": "Smooth",
  "mood": [
    "Dark",
    "Cinematic"
  ],
  "description": "Smooth, wide and low for late-night melodies",
  "author": "NoDAW",
  "params": {
    "in_gain": 0,
    "out_gain": 0,
    "mix": 100,
    "pitch": -3.5,
    "wow": 4,
    "wow_rate": 0.7,
    "flutter": 0,
    "lowpass": 10500,
    "bass": 2,
    "rev_mix": 36,
    "rev_decay": 5,
    "rev_size": 1.4,
    "rev_damp": 6000,
    "rev_pre": 28,
    "chop_pattern": "Off",
    "chop_rate": "1/8",
    "chop_depth": 100,
    "width": 135,
    "limiter": true,
    "ceiling": -1
  }
}
