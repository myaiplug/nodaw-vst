{
  "apf-preset": 1,
  "plugin": "com.nodaw.screw",
  "name": "Init",
  "type": "Utility",
  "subtype": "Default",
  "mood": [
    "Clean",
    "Neutral"
  ],
  "description": "The starting point: a gentle drop and a little room",
  "author": "NoDAW",
  "params": {
    "in_gain": 0,
