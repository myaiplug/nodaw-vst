{
  "apf-preset": 1,
  "plugin": "com.nodaw.screw",
  "name": "Classic Screw",
  "type": "Screw",
  "subtype": "Classic",
  "mood": [
    "Dark",
    "Heavy"
  ],
  "description": "About four semitones down with a warm low end, the Houston standard",
  "author": "NoDAW",
  "params": {
    "in_gain": 0,
    "out_gain": 0,
    "mix": 100,
    "pitch": -4.5,
    "wow": 6,
    "wow_rate": 0.5,
    "flutter": 0,
    "lowpass": 11000,
    "bass": 3,
    "rev_mix": 18,
    "rev_decay": 2.2,
    "rev_size": 1,
    "rev_damp": 6000,
    "rev_pre": 20,
    "chop_pattern": "Off",
    "chop_rate": "1/8",
    "chop_depth": 100,
    "width": 100,
    "limiter": true,
    "ceiling": -1
  }
}
